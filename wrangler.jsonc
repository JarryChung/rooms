{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rooms",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
